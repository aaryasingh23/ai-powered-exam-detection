# Backend
API_PORT=4000
# Session token lifetime in minutes
SESSION_TTL_MINUTES=180
# Keep seeded demo sessions "alive" with simulated events (true/false)
DEMO_SIMULATOR=true
# SQLite database file
DB_FILE=data/proctor.db

# Frontend (Vite)
# Optional: URL of an external YOLO inference service (see yolo-service/README.md).
# When set, the object-detection module uses the YOLO HTTP adapter instead of
# the in-browser MediaPipe EfficientDet-Lite0 model.
VITE_YOLO_ENDPOINT=
